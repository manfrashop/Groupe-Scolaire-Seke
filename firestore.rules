rules_version = '2';

// Règles de sécurité Firestore pour l'application GSPS — cloisonnement par profil.
// À coller dans : Console Firebase → Firestore Database → Règles.
//
// V14 : chaque profil utilise son propre compte Firebase Auth. Aucun mot de passe n'est
// embarqué dans le client. Les règles serveur restent l'autorité pour les écritures.
//
// IMPORTANT : l'application conserve encore un document agrégé /ecoles/{ecoleId}.
// Cela permet de maintenir la compatibilité avec l'architecture actuelle, mais empêche une
// isolation fine des lectures par module. La séparation en sous-collections reste un chantier
// de migration ultérieur. Tant que ce document agrégé est utilisé, tous les profils reconnus
// peuvent lire son contenu ; leurs écritures sont néanmoins limitées ci-dessous.

service cloud.firestore {
  match /databases/{database}/documents {

    match /ecoles/{ecoleId} {

      // Lecture : autorisée à tout compte de profil reconnu (les tableaux de bord et
      // rapports ont besoin de vues croisées entre modules).
      allow read: if estProfilConnu();

      // Écriture normale (le document existe déjà) : autorisée si la Direction est connectée,
      // OU si toutes les collections touchées par cette écriture précise font partie de
      // celles permises pour le profil connecté. "majLe" (horodatage) est toujours permis.
      // NB : la clé "droits" (matrice des accès) n'est dans la liste d'aucun profil hors Direction :
      // elle est donc modifiable uniquement par la Direction.
      allow update: if estDirection() ||
        (estProfilConnu() &&
         clesModifiees().hasOnly(collectionsAutoriseesPourProfil().concat(["majLe","journal"])) &&
         champsProtegesInchanges() && journalSeulementAjout());

      // Création du document (une seule fois, à la toute première mise en service) :
      // réservée à la Direction, pour que l'initialisation des données ne dépende pas
      // d'un profil restreint.
      allow create: if estDirection();

      allow delete: if false;
    }

    // Tout le reste est bloqué par défaut.
    match /{document=**} { allow read, write: if false; }
  }

  function estProfilConnu(){
    return request.auth != null && request.auth.token.email in [
      "direction@gsps-seke-siguiri.local",
      "comptabilite@gsps-seke-siguiri.local",
      "secretariat@gsps-seke-siguiri.local",
      "enseignant@gsps-seke-siguiri.local",
      "transport@gsps-seke-siguiri.local"
    ];
  }

  function estDirection(){
    return request.auth != null && request.auth.token.email == "direction@gsps-seke-siguiri.local";
  }


  // Les profils restreints ne peuvent jamais modifier la matrice des droits, les paramètres
  // administratifs, ni les compteurs de structure hors de leur périmètre explicite.
  function champsProtegesInchanges(){
    return request.resource.data.db.get("droits", {}) == resource.data.db.get("droits", {}) &&
           request.resource.data.db.get("parametres", {}) == resource.data.db.get("parametres", {});
  }

  // Ensemble des clés de premier niveau (à l'intérieur du champ "db") réellement modifiées
  // par cette écriture — permet de savoir QUELLES collections sont touchées.
  function clesModifiees(){
    return request.resource.data.db.diff(resource.data.db).affectedKeys();
  }

  // Collections que chaque profil (hors Direction, qui a un accès complet) a le droit de
  // modifier — reflète exactement les pages/actions déjà accessibles à ce profil dans
  // l'interface (voir PROFILES dans le fichier HTML), pour ne pas bloquer un usage normal.
  function collectionsAutoriseesPourProfil(){
    let email = request.auth.token.email;
    // Les collections autorisées sont désormais pilotées par la Direction (page Administration) :
    // elles sont lues dans db.droits.<profil>.collections. Si la Direction n'a encore rien
    // modifié, on retombe sur les valeurs par défaut ci-dessous (identiques à l'ancien comportement).
    let profil =
      email == "comptabilite@gsps-seke-siguiri.local" ? "comptabilite" :
      email == "secretariat@gsps-seke-siguiri.local"  ? "secretariat"  :
      email == "enseignant@gsps-seke-siguiri.local"   ? "enseignant"   :
      "transport";
    let droits = resource.data.db.get("droits", {});
    let dProfil = droits.get(profil, {});
    return (profilActif(dProfil) && dProfil.get("collections", null) != null) ? dProfil.collections :
      !profilActif(dProfil) ? [] :
      profil == "comptabilite" ?
        ["eleves","paiements","depenses","notifications","cantineAbonnes","cantineRepas","paies","compteurs"] :
      profil == "secretariat" ?
        ["eleves","livres","emprunts","annonces","notifications","compteurs"] :
      profil == "enseignant" ?
        ["notes","notesComposition","coursEmploi","examens","sanctions","livres","emprunts","lecons","compteurs"] :
      [];
  }

  // Journal de traçabilité : tout profil peut y AJOUTER des entrées (c'est ce qui trace ses propres
  // actions), mais ne peut ni en supprimer ni en modifier. Seule la Direction peut purger le journal.
  function journalSeulementAjout(){
    let avant = resource.data.db.get("journal", {});
    let apres = request.resource.data.db.get("journal", {});
    let d = apres.diff(avant);
    return d.removedKeys().size() == 0 && d.changedKeys().size() == 0;
  }

  // Un profil désactivé par la Direction ne peut plus rien écrire, même s'il a un compte valide.
  function profilActif(dProfil){
    return dProfil.get("actif", true) != false;
  }
}
